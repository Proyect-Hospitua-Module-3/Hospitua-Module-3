// Modelos y mapeo de tablas de Módulo 3 (plan técnico base).
// Las restricciones CHECK no las genera Prisma: se agregan como SQL manual en las migraciones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Login propio (transversal). Los usuarios se crean por seed.
// ---------------------------------------------------------------------------

enum AppUserRole {
  Administrador
  OTA
}

model AppUser {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String      @unique
  passwordHash String      @map("password_hash")
  role         AppUserRole
  otaId        String?     @map("ota_id")
  active       Boolean     @default(true)

  @@map("app_user")
}

// ---------------------------------------------------------------------------
// billing — 001 Actualizar porcentaje de IVA
// ---------------------------------------------------------------------------

// Fila única (id = 1). Vacía hasta que el Administrador registra el primer porcentaje.
model VatRate {
  id        Int      @id
  value     Decimal  @db.Decimal(5, 2)
  updatedBy String   @map("updated_by") @db.Uuid
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  @@map("vat_rate")
}

// Insert-only: una entrada por cada actualización exitosa.
model VatRateHistory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  valueBefore Decimal? @map("value_before") @db.Decimal(5, 2)
  valueAfter  Decimal  @map("value_after") @db.Decimal(5, 2)
  changedBy   String   @map("changed_by") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@map("vat_rate_history")
}

// ---------------------------------------------------------------------------
// pricing — 009 Modificar precio tarifa según temporada
// Índices parciales, exclusión de rangos y CHECK: SQL manual en la migración.
// ---------------------------------------------------------------------------

// Catálogo de temporadas. Retiro lógico (archived_at): nunca se borra una fila.
model Season {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  color      String    @db.Char(7)
  isDefault  Boolean   @default(false) @map("is_default")
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedBy String?   @map("archived_by") @db.Uuid
  createdAt  DateTime  @map("created_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  updatedAt  DateTime  @map("updated_at") @db.Timestamptz(6)
  updatedBy  String    @map("updated_by") @db.Uuid

  rules           SeasonRule[]
  history         SeasonRuleHistory[]
  calendarEntries SeasonCalendarEntry[] // 011: entradas del calendario que la asignan

  @@map("season")
}

// Versiones del ajuste de cada temporada; valid_to nulo solo en la vigente.
model SeasonRule {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId          String    @map("season_id") @db.Uuid
  adjustmentPercent Decimal   @map("adjustment_percent") @db.Decimal(5, 2)
  validFrom         DateTime  @map("valid_from") @db.Timestamptz(6)
  validTo           DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt         DateTime  @map("created_at") @db.Timestamptz(6)
  createdBy         String    @map("created_by") @db.Uuid

  season          Season              @relation(fields: [seasonId], references: [id])
  historyAsBefore SeasonRuleHistory[] @relation("PreviousRule")
  historyAsAfter  SeasonRuleHistory[] @relation("NewRule")

  @@index([seasonId])
  @@map("season_rule")
}

// Auditoría append-only de cada cambio efectivo: CREATE, UPDATE o RETIRE (FR-004).
model SeasonRuleHistory {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId           String   @map("season_id") @db.Uuid
  changeType         String   @map("change_type")
  previousRuleId     String?  @map("previous_rule_id") @db.Uuid
  newRuleId          String?  @map("new_rule_id") @db.Uuid
  previousAdjustment Decimal? @map("previous_adjustment") @db.Decimal(5, 2)
  newAdjustment      Decimal? @map("new_adjustment") @db.Decimal(5, 2)
  previousName       String?  @map("previous_name")
  newName            String?  @map("new_name")
  previousColor      String?  @map("previous_color") @db.Char(7)
  newColor           String?  @map("new_color") @db.Char(7)
  changedBy          String   @map("changed_by") @db.Uuid
  changedAt          DateTime @map("changed_at") @db.Timestamptz(6)

  season       Season      @relation(fields: [seasonId], references: [id])
  previousRule SeasonRule? @relation("PreviousRule", fields: [previousRuleId], references: [id])
  newRule      SeasonRule? @relation("NewRule", fields: [newRuleId], references: [id])

  @@index([seasonId])
  @@map("season_rule_history")
}

// ---------------------------------------------------------------------------
// pricing — 011 Revisar temporada del año
// CHECK, índices parciales y la restricción de exclusión: SQL manual en la migración.
// ---------------------------------------------------------------------------

// Revisión anual del calendario: inmutable una vez publicada; una sola activa por año.
model SeasonCalendarRevision {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year        Int
  revision    Int
  effectiveAt DateTime @map("effective_at") @db.Timestamptz(6)
  isActive    Boolean  @map("is_active")
  changedBy   String   @map("changed_by") @db.Uuid
  changedAt   DateTime @map("changed_at") @db.Timestamptz(6)

  entries SeasonCalendarEntry[]

  @@unique([year, revision])
  // Destino de la FK compuesta de season_calendar_entry: obliga a que cada entrada
  // repita el año de su revisión, para poder validarlo con CHECK.
  @@unique([id, year])
  @@map("season_calendar_revision")
}

// Período BASE o excepción puntual de una revisión. Solo guarda el seasonId; nombre,
// color y ajuste son del catálogo de 009.
model SeasonCalendarEntry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId String   @map("revision_id") @db.Uuid
  year       Int // año propietario: el de la revisión
  entryId    String   @map("entry_id") @db.Uuid // identidad estable entre revisiones
  seasonId   String   @map("season_id") @db.Uuid
  kind       String
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date

  revision   SeasonCalendarRevision    @relation(fields: [revisionId, year], references: [id, year])
  season     Season                    @relation(fields: [seasonId], references: [id])
  activeBase SeasonCalendarActiveBase?

  @@unique([revisionId, entryId])
  @@index([seasonId])
  @@map("season_calendar_entry")
}

// Proyección de los períodos BASE de las revisiones ACTIVAS de todos los años. Existe
// para la restricción de exclusión que impide solapes BASE entre años (plan 011).
model SeasonCalendarActiveBase {
  calendarEntryId String                   @id @map("calendar_entry_id") @db.Uuid
  year            Int
  period          Unsupported("daterange")

  entry SeasonCalendarEntry @relation(fields: [calendarEntryId], references: [id])

  @@index([year])
  @@map("season_calendar_active_base")
}

// ---------------------------------------------------------------------------
// pricing — 005 Consultar tarifa dinámica
// Insert-only: ningún camino de código hace UPDATE ni DELETE (cotización inmutable).
// CHECK: SQL manual en la migración.
// ---------------------------------------------------------------------------

// Cotización del hospedaje de una habitación, pedida por Módulo 2 al crear la reserva.
// `id` es el quoteId que se devuelve a Módulo 2.
model LodgingQuote {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId        String   @map("room_id") @db.Uuid
  checkInDate   DateTime @map("check_in_date") @db.Date
  checkOutDate  DateTime @map("check_out_date") @db.Date // exclusiva
  currency      String   @db.Char(3)
  lodgingAmount Decimal  @map("lodging_amount") @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  nights LodgingQuoteNight[]

  @@map("lodging_quote")
}

// Una fila por noche de la cotización, con lo necesario para reconstruir su valor:
// tarifa base de Módulo 1, temporada y ajuste aplicados y tarifa resultante.
// La clave (quote_id, night_date) cumple el UNIQUE(quote_id, night_date) del plan.
model LodgingQuoteNight {
  quoteId           String   @map("quote_id") @db.Uuid
  nightDate         DateTime @map("night_date") @db.Date
  baseRate          Decimal  @map("base_rate") @db.Decimal(14, 2)
  seasonName        String   @map("season_name")
  adjustmentPercent Decimal  @map("adjustment_percent") @db.Decimal(6, 2)
  rate              Decimal  @db.Decimal(14, 2)

  quote LodgingQuote @relation(fields: [quoteId], references: [id])

  @@id([quoteId, nightDate])
  @@map("lodging_quote_night")
}

// ---------------------------------------------------------------------------
// settlement — 007 Generar liquidación
// Insert-only: ningún camino de código hace UPDATE ni DELETE (liquidación inmutable).
// CHECK: SQL manual en la migración.
// ---------------------------------------------------------------------------

// Liquidación Final de la estancia de una habitación, generada al registrar su check-out.
// quote_id no tiene FK hacia lodging_quote: settlement lee las cotizaciones de pricing
// solo a través de LodgingQuoteQueryPort (plan base, regla 5).
model Settlement {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stayId                  String   @unique @map("stay_id") @db.Uuid // una por estancia (FR-010)
  reservationRef          String   @map("reservation_ref")
  roomId                  String   @map("room_id") @db.Uuid
  categoryRoom            String   @map("category_room")
  checkInDate             DateTime @map("check_in_date") @db.Date // fecha real
  checkOutDate            DateTime @map("check_out_date") @db.Date // fecha real
  quoteId                 String   @map("quote_id") @db.Uuid
  channel                 String // DIRECT | OTA
  otaId                   String?  @map("ota_id")
  otaConfirmationCode     String?  @map("ota_confirmation_code")
  otaCommissionPercentage Decimal? @map("ota_commission_percentage") @db.Decimal(5, 2)
  currency                String   @db.Char(3)
  lodgingAmount           Decimal  @map("lodging_amount") @db.Decimal(14, 2)
  baseLodgingAmount       Decimal  @map("base_lodging_amount") @db.Decimal(14, 2)
  dynamicAdjustmentAmount Decimal  @map("dynamic_adjustment_amount") @db.Decimal(14, 2) // puede ser negativo
  otaCommissionAmount     Decimal  @map("ota_commission_amount") @db.Decimal(14, 2)
  netIncome               Decimal  @map("net_income") @db.Decimal(14, 2)
  status                  String // siempre FINAL
  sourceEventId           String   @map("source_event_id") @db.Uuid
  generatedAt             DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  // 006: a lo sumo una factura por liquidación (UNIQUE(invoice.settlement_id)).
  invoice Invoice?

  // 002 busca por reserva y habitación; 003, la liquidación más reciente de cada OTA.
  @@index([reservationRef, roomId])
  @@index([otaId, generatedAt(sort: Desc)])
  @@map("settlement")
}

// ---------------------------------------------------------------------------
// Feature 006 · Generar factura final (bounded context billing)
// Insert-only: ningún camino de código hace UPDATE ni DELETE de invoice (factura inmutable).
// El único UPDATE es el del consecutivo, dentro de la misma transacción que emite.
// CHECK y fila inicial del consecutivo: SQL manual en la migración.
// ---------------------------------------------------------------------------

// Factura fiscal definitiva de una liquidación Final. Copia los datos de la liquidación que
// 008 y 002 consultan, para no recalcular ni unir con settlement.
model Invoice {
  id                  String     @id @db.Uuid
  invoiceNumber       BigInt     @unique @map("invoice_number") // consecutivo oficial (FR-005)
  status              String // siempre ISSUED
  // clock_timestamp() y no now(): now() es la hora en que empezó la transacción, antes de
  // esperar el bloqueo del consecutivo, y desordenaría issued_at respecto del número.
  issuedAt            DateTime   @default(dbgenerated("clock_timestamp()")) @map("issued_at") @db.Timestamptz(6)
  settlementId        String     @unique @map("settlement_id") @db.Uuid
  settlement          Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stayId              String     @unique @map("stay_id") @db.Uuid // idempotencia (FR-007)
  sourceEventId       String     @map("source_event_id") @db.Uuid
  reservationRef      String     @map("reservation_ref")
  channel             String // DIRECT | OTA
  otaId               String?    @map("ota_id")
  customerName        String     @map("customer_name")
  customerTaxId       String     @map("customer_tax_id")
  currency            String     @db.Char(3)
  lodgingAmount       Decimal    @map("lodging_amount") @db.Decimal(14, 2)
  otaCommissionAmount Decimal    @map("ota_commission_amount") @db.Decimal(14, 2) // referencia, no se cobra
  netIncome           Decimal    @map("net_income") @db.Decimal(14, 2) // referencia, no se cobra
  vatRateApplied      Decimal    @map("vat_rate_applied") @db.Decimal(5, 2) // IVA al emitir, sin FK
  vatAmount           Decimal    @map("vat_amount") @db.Decimal(14, 2)
  totalAmount         Decimal    @map("total_amount") @db.Decimal(14, 2) // hospedaje + IVA

  // Los índices de búsqueda los agrega 008 (Gestionar facturación).
  @@map("invoice")
}

// Fila única (id = 1) con el último número emitido. Se bloquea con SELECT … FOR UPDATE al
// emitir; un rollback revierte el incremento, así que no quedan huecos (nextval() sí los
// dejaría). La crea la migración con last_number = 0 y nunca se reinicia.
model InvoiceNumberCounter {
  id         Int    @id
  lastNumber BigInt @map("last_number")

  @@map("invoice_number_counter")
}
