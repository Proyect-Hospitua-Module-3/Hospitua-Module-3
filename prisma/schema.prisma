// Modelos y mapeo de tablas de Módulo 3 (plan técnico base).
// Las restricciones CHECK no las genera Prisma: se agregan como SQL manual en las migraciones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Login propio (transversal). Los usuarios se crean por seed.
// ---------------------------------------------------------------------------

enum AppUserRole {
  Administrador
  OTA
}

model AppUser {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String      @unique
  passwordHash String      @map("password_hash")
  role         AppUserRole
  otaId        String?     @map("ota_id")
  active       Boolean     @default(true)

  @@map("app_user")
}

// ---------------------------------------------------------------------------
// billing — 001 Actualizar porcentaje de IVA
// ---------------------------------------------------------------------------

// Fila única (id = 1). Vacía hasta que el Administrador registra el primer porcentaje.
model VatRate {
  id        Int      @id
  value     Decimal  @db.Decimal(5, 2)
  updatedBy String   @map("updated_by") @db.Uuid
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  @@map("vat_rate")
}

// Insert-only: una entrada por cada actualización exitosa.
model VatRateHistory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  valueBefore Decimal? @map("value_before") @db.Decimal(5, 2)
  valueAfter  Decimal  @map("value_after") @db.Decimal(5, 2)
  changedBy   String   @map("changed_by") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@map("vat_rate_history")
}

// ---------------------------------------------------------------------------
// pricing — 009 Modificar precio tarifa según temporada
// Índices parciales, exclusión de rangos y CHECK: SQL manual en la migración.
// ---------------------------------------------------------------------------

// Catálogo de temporadas. Retiro lógico (archived_at): nunca se borra una fila.
model Season {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  color      String    @db.Char(7)
  isDefault  Boolean   @default(false) @map("is_default")
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedBy String?   @map("archived_by") @db.Uuid
  createdAt  DateTime  @map("created_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  updatedAt  DateTime  @map("updated_at") @db.Timestamptz(6)
  updatedBy  String    @map("updated_by") @db.Uuid

  rules           SeasonRule[]
  history         SeasonRuleHistory[]
  calendarEntries SeasonCalendarEntry[] // 011: entradas del calendario que la asignan

  @@map("season")
}

// Versiones del ajuste de cada temporada; valid_to nulo solo en la vigente.
model SeasonRule {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId          String    @map("season_id") @db.Uuid
  adjustmentPercent Decimal   @map("adjustment_percent") @db.Decimal(5, 2)
  validFrom         DateTime  @map("valid_from") @db.Timestamptz(6)
  validTo           DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt         DateTime  @map("created_at") @db.Timestamptz(6)
  createdBy         String    @map("created_by") @db.Uuid

  season          Season              @relation(fields: [seasonId], references: [id])
  historyAsBefore SeasonRuleHistory[] @relation("PreviousRule")
  historyAsAfter  SeasonRuleHistory[] @relation("NewRule")

  @@index([seasonId])
  @@map("season_rule")
}

// Auditoría append-only de cada cambio efectivo: CREATE, UPDATE o RETIRE (FR-004).
model SeasonRuleHistory {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId           String   @map("season_id") @db.Uuid
  changeType         String   @map("change_type")
  previousRuleId     String?  @map("previous_rule_id") @db.Uuid
  newRuleId          String?  @map("new_rule_id") @db.Uuid
  previousAdjustment Decimal? @map("previous_adjustment") @db.Decimal(5, 2)
  newAdjustment      Decimal? @map("new_adjustment") @db.Decimal(5, 2)
  previousName       String?  @map("previous_name")
  newName            String?  @map("new_name")
  previousColor      String?  @map("previous_color") @db.Char(7)
  newColor           String?  @map("new_color") @db.Char(7)
  changedBy          String   @map("changed_by") @db.Uuid
  changedAt          DateTime @map("changed_at") @db.Timestamptz(6)

  season       Season      @relation(fields: [seasonId], references: [id])
  previousRule SeasonRule? @relation("PreviousRule", fields: [previousRuleId], references: [id])
  newRule      SeasonRule? @relation("NewRule", fields: [newRuleId], references: [id])

  @@index([seasonId])
  @@map("season_rule_history")
}

// ---------------------------------------------------------------------------
// pricing — 011 Revisar temporada del año
// CHECK, índices parciales y la restricción de exclusión: SQL manual en la migración.
// ---------------------------------------------------------------------------

// Revisión anual del calendario: inmutable una vez publicada; una sola activa por año.
model SeasonCalendarRevision {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year        Int
  revision    Int
  effectiveAt DateTime @map("effective_at") @db.Timestamptz(6)
  isActive    Boolean  @map("is_active")
  changedBy   String   @map("changed_by") @db.Uuid
  changedAt   DateTime @map("changed_at") @db.Timestamptz(6)

  entries SeasonCalendarEntry[]

  @@unique([year, revision])
  // Destino de la FK compuesta de season_calendar_entry: obliga a que cada entrada
  // repita el año de su revisión, para poder validarlo con CHECK.
  @@unique([id, year])
  @@map("season_calendar_revision")
}

// Período BASE o excepción puntual de una revisión. Solo guarda el seasonId; nombre,
// color y ajuste son del catálogo de 009.
model SeasonCalendarEntry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId String   @map("revision_id") @db.Uuid
  year       Int // año propietario: el de la revisión
  entryId    String   @map("entry_id") @db.Uuid // identidad estable entre revisiones
  seasonId   String   @map("season_id") @db.Uuid
  kind       String
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date

  revision   SeasonCalendarRevision    @relation(fields: [revisionId, year], references: [id, year])
  season     Season                    @relation(fields: [seasonId], references: [id])
  activeBase SeasonCalendarActiveBase?

  @@unique([revisionId, entryId])
  @@index([seasonId])
  @@map("season_calendar_entry")
}

// Proyección de los períodos BASE de las revisiones ACTIVAS de todos los años. Existe
// para la restricción de exclusión que impide solapes BASE entre años (plan 011).
model SeasonCalendarActiveBase {
  calendarEntryId String                   @id @map("calendar_entry_id") @db.Uuid
  year            Int
  period          Unsupported("daterange")

  entry SeasonCalendarEntry @relation(fields: [calendarEntryId], references: [id])

  @@index([year])
  @@map("season_calendar_active_base")
}
