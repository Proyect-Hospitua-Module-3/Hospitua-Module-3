# Copia este archivo como .env y ajusta los valores. El .env nunca se versiona.

# PostgreSQL (los valores coinciden con docker-compose.yml)
DATABASE_URL=postgresql://hospitua:hospitua@localhost:5432/modulo3?schema=public

# JWT del login propio de Módulo 3
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN_SECONDS=3600

PORT=3000

# Usuarios que crea el seed (no hay feature de gestión de usuarios)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=cambia-esta-clave
SEED_OTA_USERNAME=ota-demo
SEED_OTA_PASSWORD=cambia-esta-clave
SEED_OTA_ID=booking

# Opcional: base de datos ya migrada para las pruebas de integración del repositorio
# TEST_DATABASE_URL=postgresql://hospitua:hospitua@localhost:5432/modulo3_test?schema=public
