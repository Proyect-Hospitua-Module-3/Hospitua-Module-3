# Copia este archivo como .env y ajusta los valores. El .env nunca se versiona.

# PostgreSQL (los valores coinciden con docker-compose.yml)
DATABASE_URL=postgresql://hospitua:hospitua@localhost:5432/modulo3?schema=public

# JWT del login propio de Módulo 3
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN_SECONDS=3600

PORT=3000

# URL y tiempo máximo de espera de Módulo 1 para consultar tarifa base
MODULE1_BASE_URL=http://localhost:8080
MODULE1_TIMEOUT_MS=500

# URL y tiempo máximo de espera de Módulo 2 para consultar reservas (feature 007)
MODULE2_BASE_URL=http://localhost:8081
MODULE2_TIMEOUT_MS=500
# RabbitMQ para el evento de check-out de Módulo 1 (feature 010; coincide con docker-compose.yml).
# Con ella se consume modulo3.checkout; sin ella la aplicación arranca, pero los check-out esperan en la cola.
RABBITMQ_URL=amqp://hospitua:hospitua@localhost:5672

# Usuarios que crea el seed (no hay feature de gestión de usuarios)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=cambia-esta-clave
SEED_OTA_USERNAME=ota-demo
SEED_OTA_PASSWORD=cambia-esta-clave
SEED_OTA_ID=booking

# Opcional: base de datos ya migrada para las pruebas de integración del repositorio
# TEST_DATABASE_URL=postgresql://hospitua:hospitua@localhost:5432/modulo3_test?schema=public
# Opcional: RabbitMQ para las pruebas de integración de mensajería (vacía las colas modulo3.checkout*)
# TEST_RABBITMQ_URL=amqp://hospitua:hospitua@localhost:5672
